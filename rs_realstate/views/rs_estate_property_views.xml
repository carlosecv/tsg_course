    <record id="view_rs_estate_property_map" model="ir.ui.view">
        <field name="name">rs.estate.property.map</field>
        <field name="model">rs.estate.property</field>
        <field name="arch" type="xml">
            <map string="Properties Map" res_partner="partner_id" default_order="name"/>
        </field>
    </record> 


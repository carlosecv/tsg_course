<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- =========================
         AUTOS VOLADORES
    ========================== -->
    <record id="view_vehicle_auto_flying_list" model="ir.ui.view">
        <field name="name">vehicle.auto.flying.list</field>
        <field name="model">vehicle.auto.flying</field>
        <field name="arch" type="xml">
            <list string="Flying Autos">
                <field name="brand"/>
                <field name="model_name"/>
                <field name="year"/>
                <field name="max_altitude"/>
                <field name="flight_range"/>
                <field name="pilot_license_required"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_auto_flying_form" model="ir.ui.view">
        <field name="name">vehicle.auto.flying.form</field>
        <field name="model">vehicle.auto.flying</field>
        <field name="arch" type="xml">
            <form string="Flying Auto">
                <sheet>
                    <group string="General Data">
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="max_speed"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Flying Features">
                        <group>
                            <field name="max_altitude"/>
                            <field name="flight_range"/>
                            <field name="pilot_license_required"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_auto_flying" model="ir.actions.act_window">
        <field name="name">Flying Autos</field>
        <field name="res_model">vehicle.auto.flying</field>
        <field name="view_mode">list,form</field>
    </record>

 
    
</odoo>
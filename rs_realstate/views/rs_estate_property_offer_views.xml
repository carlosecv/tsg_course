<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_rs_estate_property_offer_list" model="ir.ui.view">
        <field name="name">view.rs.estate.property.offer.list</field>
        <field name="model">rs.estate.property.offer</field>
        <field name="mode">primary</field>
        <field name="priority" eval="16" />
        <field name="arch" type="xml">
            <list string="Properties" create="true" delete="true" edit="true">
                <field name="property_id" />
                <field name="partner_id" />
                <field name="currency_id" />
                <field name="price" />
                <field name="create_date" />
                <field name="validity_days" />
                <field name="deadline" />
                <field name="sequence" />
                <field name="state" decoration-success="state == 'sold'"
                    decoration-info="state == 'draft'" decoration-primary="state == 'accepted'"
                    widget="badge" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_rs_estate_property_offer_form" model="ir.ui.view">
        <field name="name">view.rs.estate.property.offer.form</field>
        <field name="model">rs.estate.property.offer</field>
        <field name="mode">primary</field>
        <field name="priority" eval="16" />
        <field name="arch" type="xml">
            <form string="Properties" create="true" delete="true" edit="true">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,accepted,reject,cancel" options="{'clickable': '1'}" />
                    <button name="message_user" type="object" string="Message to User"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="partner_id" class="oe_edit_only" />
                        <h1>
                            <field name="partner_id" class="oe_inline"
                                placeholder="name" readonly="1" force_save="1" />
                        </h1>
                        <field name="partner_id" />
                    </div>
                    <group colspan="4">
                        <group>
                            <field name="property_id" />
                            <!-- <field name="partner_id" /> -->
                            <field name="currency_id" />
                            <field name="price" />
                        </group>
                        <group>
                            <field name="create_date" />
                            <field name="elapsed_days"/>
                            <field name="validity_days" />
                            <field name="deadline" />
                            <field name="sequence" />
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rs_estate_property_offer_search" model="ir.ui.view">
        <field name="name">view.rs.estate.property.offer.search</field>
        <field name="model">rs.estate.property.offer</field>
        <field name="type">search</field>
        <field name="mode">primary</field>
        <field name="priority" eval="16" />
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="price" />
                <field name="property_id" />
                <separator />
                <!-- <filter name="elapsed_five_days" string="Created more than 5 days" domain="[('elapsed_days', '&gt;', 5)]"
                />                 -->
                <group>
                    <field name="state" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_rs_estate_property_offer" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Offer</field>
        <field name="res_model">rs.estate.property.offer</field>
        <field name="view_mode">list,form,activity</field>
        <field name="target">current</field>
        <field name="search_view_id" ref="view_rs_estate_property_offer_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add new Properties at Offer
            </p>
            <p>
                This are the properties to sell.
            </p>
        </field>
    </record>

</odoo>
<odoo>

    <record id="ir_cron_update_property_state" model="ir.cron">
        <field name="name">Update Property status to Sold on accepted Offers</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model.search([('state', '=', 'accepted')]).action_update_property_state_sold("Update Property status CRON JOB")</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

</odoo>

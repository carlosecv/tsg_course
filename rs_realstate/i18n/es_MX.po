#. module: rs_realstate
#: model:mail.template,body_html:rs_realstate.mail_template_estate_property
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"            <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <t t-set=\"property_label\" t-value=\"'property' if "
"object.state != 'sold' else 'sold property'\"/>\n"
"                Hello,\n"
"                <br/><br/>\n"
"\n"
"                We are sharing with you the information of the\n"
"                <span style=\"font-weight: bold;\" t-"
"out=\"object.display_name or ''\"/>\n"
"                <br/><br/>\n"
"\n"
"                <t t-if=\"object.partner_id\">\n"
"                    Customer:\n"
"                    <span style=\"font-weight: bold;\" t-"
"out=\"object.partner_id.name or ''\"/>\n"
"                    <br/>\n"
"                </t>\n"
"\n"
"                <br/>\n"
"                Please do not hesitate to contact us if you have any "
"questions.\n"
"                <br/><br/>\n"
"\n"
"                <t t-out=\"user.name\"/>\n"
"                <br/><br/>\n"
"            </p>\n"
"        </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"            <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"               <t t-set=\"property_label\" t-value=\"'property' if "
"object.state != 'sold' else 'sold property'\"/> \n"
"                Hola,\n"
"               <br/><br/> \n"
"                Te compartimos la información de la\n"
"               <span style=\"font-weight: bold;\" t-out=\"object. "
"display_name or ''\"/>\n"
"                <br/><br/> \n"
"\n"
"                \n"
" <t t-if=\"object.partner_id\">                   Cliente:\n"
"                   <span style=\"font-weight: bold;\" t-"
"out=\"object.partner_id.name or ''\"/>\n"
"                    <br/> \n"
"                \n"
" </t></p>\n"
"        </div>\n"
"            "


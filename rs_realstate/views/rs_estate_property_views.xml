    <!-- Main window action for "model"  map,pivot,gantt -->
    <record id="action_rs_estate_property" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Properties</field>
        <field name="res_model">rs.estate.property</field>
        <field name="view_mode">list,form,kanban,map</field>
        <field name="target">current</field>
        <field name="search_view_id" ref="view_rs_estate_property_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add new Properties at Offer
            </p><p>
                This are the properties to sell.
            </p>
        </field>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <template id="report_estate_property_document">
    <!-- ESTE wrapper asegura el <main> -->
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <main class="page">
            <h2>Property: <span t-field="o.name"/></h2>
            <hr/>
            <h3>Property Details</h3>
            <div class="row">
              <div class="col-6">
                <p><strong>Type:</strong> <span t-field="o.property_type_id"/></p>
                <p><strong>Address:</strong> <span t-field="o.partner_id"/></p>
                <p><strong>Zip Code:</strong> <span t-field="o.postcode"/></p>
                <p><strong>Salesperson:</strong> <span t-field="o.user_id"/></p>
              </div>
              <div class="col-6">
                <p><strong>Expected Price:</strong> <span t-field="o.expected_price"/></p>
                <p><strong>Selling Price:</strong> <span t-field="o.selling_price"/></p>
                <p><strong>Status:</strong> <span t-field="o.state"/></p>
                <p><strong>Start Date:</strong> <span t-field="o.start_date"/></p>
              </div>
            </div>


          </main>
        </t>
      </t>
    </t>
  </template>


    <!-- =========================
         IR.ACTIONS.REPORT
         ========================= -->
    <record id="action_report_estate_property" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rs_realstate.report_estate_property_document</field>
        <field name="report_file">rs_realstate.report_estate_property_document</field>

        <!-- Nombre dinámico del PDF -->
        <field name="print_report_name">'Property - %s' % (object.name)</field>

        <!-- Binding para que aparezca en Print -->
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>
 
    

</odoo>
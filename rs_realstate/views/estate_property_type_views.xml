<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Vista de Lista (List) -->
    <record id="view_estate_property_type_list" model="ir.ui.view">
        <field name="name">estate.property.type.list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">                      
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario (Form) -->
    <record id="view_estate_property_type_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Apartment"/></h1>
                    </div>
                     <group colspan="4" >
                        <group>                        
                            <field name="active"/>
                        </group>                        
                    </group>   
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda (Search) -->
    <record id="view_estate_property_type_search" model="ir.ui.view">
        <field name="name">estate.property.type.search</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <search string="Search Property Types">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Acción (Action) -->
    <record id="action_estate_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new property type (e.g. House, Apartment)
            </p>
        </field>
    </record>

    <!-- Menú (ActionMenu) -->
    <!-- Lo colocamos dentro del menú raíz que ya creaste en el otro archivo -->
    <menuitem 
        id="estate_property_type_menu" 
        name="Property Types" 
        parent="estate_properties_menu_root" 
        action="action_estate_property_type" 
        sequence="20"/>

</odoo>

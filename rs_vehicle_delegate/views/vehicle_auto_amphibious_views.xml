<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================
         AUTOS ANFIBIOS
    ========================== -->
    <record id="view_vehicle_auto_amphibious_list" model="ir.ui.view">
        <field name="name">vehicle.auto.amphibious.list</field>
        <field name="model">vehicle.auto.amphibious</field>
        <field name="arch" type="xml">
            <list string="Amphibious Autos">
                <field name="brand"/>
                <field name="model_name"/>
                <field name="year"/>
                <field name="water_speed"/>
                <field name="max_depth"/>
                <field name="propeller_mode"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_auto_amphibious_form" model="ir.ui.view">
        <field name="name">vehicle.auto.amphibious.form</field>
        <field name="model">vehicle.auto.amphibious</field>
        <field name="arch" type="xml">
            <form string="Amphibious Auto">
                <sheet>
                    <group string="General Data">
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="max_speed"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Amphibious Features">
                        <group>
                            <field name="water_speed"/>
                            <field name="max_depth"/>
                            <field name="propeller_mode"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_auto_amphibious" model="ir.actions.act_window">
        <field name="name">Amphibious Autos</field>
        <field name="res_model">vehicle.auto.amphibious</field>
        <field name="view_mode">list,form</field>
    </record>

   

</odoo>
<?xml version='1.0' encoding='utf-8'?>
<odoo>


    <!-- list view for "model" -->
    <record id="view_rs_estate_property_list" model="ir.ui.view">
        <field name="name">view.rs.estate.property.list</field>
        <field name="model">rs.estate.property</field>
        <field name="mode">primary</field>
        <field name="priority" eval="16" />
        <field name="arch" type="xml">
            <list string="Properties" create="true" delete="true" edit="true">
                <field name="active" invisible="1"/>
                <field name="name" />
                <field name="partner_id" />
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="garden_area"/>
                <field name="total_area" readonly="1"/>
                <field name="categ_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                <field name="state" decoration-success="state == 'sold'" decoration-info="state == 'draft'" decoration-primary="state == 'accepted'"  widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

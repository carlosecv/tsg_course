<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- model.name form view -->
    <record id="offer_asistant_wizard_view_form" model="ir.ui.view">
        <field name="name">offer.asistant.wizard.view.form</field>
        <field name="model">offer.asistant.wizard</field>
        <field name="arch" type="xml">
           <!-- model.name form view -->
            <form string="Create Property + Offer">
                <sheet>
                    <group string="Property">
                        <field name="address_id"/>
                        <field name="user_id"/>
                        <field name="currency_id"/>
                        <field name="selling_price"/>
                    </group>

                    <group string="Offer">
                        <field name="customer_id"/>
                        <field name="price"/>
                    </group>

                </sheet>

                <footer>
                    <button name="action_create_property_and_offer"
                            type="object"
                            string="Create"
                            class="btn-primary"
                            data-hotkey="c"

                            />
                    <button string="Skip" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- model.name action window -->
    <record id="offer_asistant_wizard_action" model="ir.actions.act_window">
        <field name="name">offer.asistant.wizard.action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">offer.asistant.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>        
    </record>

    

</odoo>
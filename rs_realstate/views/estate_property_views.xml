<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
        
    <!-- list view for "model" -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">view.estate.property.list</field>
        <field name="model">estate.property</field>        
        <field name="mode">primary</field>
        <field name="priority" eval="16" />    
        <field name="arch" type="xml">
            <list string="Properties" create="true" delete="true" edit="true">
                <field name="active" invisible="1"/>
                <field name="name" />
                <field name="partner_id" />
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="categ_ids" widget="many2many_tags" />                
                <field name="state" decoration-success="state == 'sold'" decoration-info="state == 'draft'" decoration-primary="state == 'accepted'"  widget="badge" optional="hide"/>
            </list>
        </field>
    </record>
    
    <!-- Form view for "model" -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">view.estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="mode">primary</field>
        <field name="priority" eval="16" />        
        <field name="arch" type="xml">
            <form string="Properties" create="true" delete="true" edit="true">    
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,receive,accepted,sold" options="{'clickable': '1'}" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;image_128&quot;}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" class="oe_inline"
                                placeholder="name" readonly="1" force_save="1" />
                        </h1>
                        <field name="categ_ids" widget="many2many_tags" />
                    </div>

                    <group colspan="4" >
                        <group>
                            <field name="partner_id" />
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="currency_id" />
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>                        
                    </group>                    
                    <notebook>                        
                        <page string="Description" >
                            <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="garage"/>
                            <field name="garden"/>
                            </group>
                        </page>
                        
                        <page string="Offers" >
                            <field name="offer_ids">                                                        
                                <list string="Offers" create="true" delete="true" edit="true">
                                    <field name="sequence" widget="handle" />
                                    <field name="partner_id"/>
                                    <field name="currency_id"/>
                                    <field name="price"/>
                                    <field name="state"/>                                    
                                </list>                            
                            </field>
                        </page>
                        <page name="page_brochure" string="Brochure">
                            <group>
                                <field name="brochure"/>
                                <field name="brochure2"/>
                            </group>
                        </page>
                        <page name="page_signature" string="Signature">
                            <group>                        
                                <field name="signature" widget="signature"/>
                            </group>
                        </page>
                                              
                                                
                    </notebook>
                    
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search view for "model" -->
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">view.estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="type">search</field>
        <field name="mode">primary</field>
        <field name="priority" eval="16" />        
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name" />                                
                <separator />                                    
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>                                
                <separator/>
                <filter string="Create Date" name="filter_create_date" date="create_date"/>
                <group>
                    <field name="state"/>
                </group>
            </search>
        </field>
    </record>

    
    <record id="view_estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <field name="name"/>
                <field name="image_256"/>
                <field name="property_type_id"/>
                <field name="expected_price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="active"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card o_kanban_record">
                            <div class="o_kanban_card_header d-flex align-items-start gap-2">
                                <div class="o_kanban_image me-2">
                                    <field name="image_256" widget="image" class="o_kanban_avatar"/>
                                </div>

                                <div class="o_kanban_header_text flex-grow-1">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="property_type_id" options="{'no_create': True}"/>
                                    </div>
                                </div>

                                <div class="o_kanban_badge ms-auto">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>

                            <div class="o_kanban_card_content mt-2">
                                <div class="o_kanban_row">
                                    <span class="text-muted">Expected:</span>
                                    <span class="ms-1">
                                        <field name="expected_price" widget="monetary"
                                            options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>

                                <div class="o_kanban_row mt-1">
                                    <span class="text-muted">Salesperson:</span>
                                    <span class="ms-1">
                                        <field name="user_id"/>
                                    </span>
                                </div>
                            </div>


                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Main window action for "model" -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>        
        <field name="target">current</field>
        <field name="search_view_id" ref="view_estate_property_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add new Properties at Offer
            </p><p>
                This are the properties to sell.
            </p>
        </field>
    </record>

    

    <!-- Main menu for "model" -->
    <!-- This Menu Item will appear in the Upper bar, that's why It needs NO parent or action -->
    <menuitem id="estate_properties_menu_root" name="Real State" sequence="10" >
        <menuitem id="estate_property_menu" name="Properties" sequence="10" action="action_estate_property" />                
    </menuitem>
    
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================
         AUTOS DEPORTIVOS
    ========================== -->
    <record id="view_vehicle_auto_sport_list" model="ir.ui.view">
        <field name="name">vehicle.auto.sport.list</field>
        <field name="model">vehicle.auto.sport</field>
        <field name="arch" type="xml">
            <list string="Sport Autos">
                <field name="brand"/>
                <field name="model_name"/>
                <field name="year"/>
                <field name="acceleration_0_100"/>
                <field name="traction_type"/>
                <field name="turbo_mode"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_auto_sport_form" model="ir.ui.view">
        <field name="name">vehicle.auto.sport.form</field>
        <field name="model">vehicle.auto.sport</field>
        <field name="arch" type="xml">
            <form string="Sport Auto">
                <sheet>
                    <group string="General Data">
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="max_speed"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Sport Features">
                        <group>
                            <field name="acceleration_0_100"/>
                            <field name="traction_type"/>
                            <field name="turbo_mode"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_auto_sport" model="ir.actions.act_window">
        <field name="name">Sport Autos</field>
        <field name="res_model">vehicle.auto.sport</field>
        <field name="view_mode">list,form</field>
    </record>

    
</odoo>